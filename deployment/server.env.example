POSTGRES_DB=crm
POSTGRES_USER=crm
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://crm:replace-with-a-long-random-password@postgres:5432/crm
CRM_CREDENTIALS_KEY=replace-with-a-32-byte-url-safe-base64-fernet-key
FLASK_SECRET_KEY=replace-with-a-long-random-flask-secret
CRM_NODE_ID=hk
CRM_QUERY_WORKERS=5
CRM_TRANSFER_WORKERS=2
CRM_HTTP_PORT=5001
MIGRATION_DATA_DIR=../data

# Used by scripts/backup_postgres.sh and scripts/verify_postgres_restore.sh.
BACKUP_DIR=../backups
BACKUP_RETENTION_DAYS=30
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_AGE_IDENTITY=/secure/path/to/age-identity.txt
